# ─── 마일스톤 1 (필수) ───
NOTION_API_KEY=
# Portfolio DB의 Database ID (Data Source ID 아님 주의)
NOTION_PORTFOLIO_DB_ID=b7e07753143c453191cddb2deee990f1

# ─── 마일스톤 2: 분석 발표 자료 (필수) ───
# Google AI Studio (https://aistudio.google.com/app/apikey)에서 발급
GEMINI_API_KEY=
# 모델 ID 오버라이드 (기본값: gemma-4-31b-it). 다른 Gemma/Gemini 모델로 바꾸고 싶을 때만 채움
GEMINI_MODEL=

# Google Cloud Console → APIs → YouTube Data API v3 활성화 후 발급
# 분석 영상 검색 + 시장 반응(영상 댓글) 모두 이 키 하나로 처리
YOUTUBE_API_KEY=

# (선택) Reddit OAuth — 비인증 호출은 2024년부터 거의 차단(HTTP 403)되어 권장.
# https://www.reddit.com/prefs/apps 에서 "script" 타입 앱 생성 후 발급.
# 4개 모두 채워야 OAuth 사용. 하나라도 비면 공개 엔드포인트로 폴백(거의 실패).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ─── 마일스톤 3: 영상 호스팅 + 카카오 알림 ───
KAKAO_REST_KEY=
KAKAO_REFRESH_TOKEN=
# Client Secret이 카카오 콘솔에서 "사용함"인 경우만 채우기. "사용 안 함"이면 비워두기.
KAKAO_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
